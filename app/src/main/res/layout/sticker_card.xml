<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:padding="@dimen/sticker_padding">

	<ImageButton
		android:id="@+id/stickerButton"
		android:layout_width="@dimen/pack_dimens"
		android:layout_height="@dimen/pack_dimens"
		android:background="@drawable/sticker_ripple"
		android:contentDescription="@string/pack_icon"
		android:cropToPadding="true"
		android:padding="@dimen/sticker_padding"
		android:scaleType="fitCenter" />
</FrameLayout>
