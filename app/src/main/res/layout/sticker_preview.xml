<?xml version="1.0" encoding="utf-8"?>
<!-- A scrim over the keyboard with the sticker on a raised, rounded surface, rather than a flat
     panel the same colour as everything behind it. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@color/scrim">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_centerInParent="true"
		android:layout_margin="@dimen/content_margin"
		android:background="@drawable/preview_surface"
		android:elevation="8dp"
		android:orientation="vertical"
		android:padding="@dimen/content_margin">

		<RelativeLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<ImageButton
				android:id="@+id/deleteButton"
				android:layout_width="@dimen/pack_dimens"
				android:layout_height="@dimen/pack_dimens"
				android:layout_alignParentStart="true"
				android:background="@drawable/sticker_ripple"
				android:contentDescription="@string/delete_sticker"
				android:padding="@dimen/sticker_padding"
				android:scaleType="fitCenter" />

			<TextView
				android:id="@+id/stickerInfo"
				style="@style/body_text"
				android:layout_width="match_parent"
				android:layout_centerVertical="true"
				android:layout_marginStart="@dimen/sticker_padding"
				android:layout_marginEnd="@dimen/sticker_padding"
				android:layout_toStartOf="@id/favouriteButton"
				android:layout_toEndOf="@id/deleteButton"
				android:ellipsize="middle"
				android:gravity="center"
				android:maxLines="2"
				android:textSize="@dimen/text_size_tiny"
				android:text="" />

			<ImageButton
				android:id="@+id/favouriteButton"
				android:layout_width="@dimen/pack_dimens"
				android:layout_height="@dimen/pack_dimens"
				android:layout_alignParentEnd="true"
				android:background="@drawable/sticker_ripple"
				android:contentDescription="@string/favourite_toggle"
				android:padding="@dimen/sticker_padding"
				android:scaleType="fitCenter" />
		</RelativeLayout>

		<ImageButton
			android:id="@+id/stickerButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="@dimen/content_margin"
			android:background="@color/transparent"
			android:contentDescription="@string/sticker_icon"
			android:cropToPadding="true"
			android:scaleType="fitCenter" />

		<TextView
			style="@style/body_text"
			android:layout_width="match_parent"
			android:layout_marginTop="@dimen/content_margin"
			android:alpha="0.7"
			android:gravity="center"
			android:textSize="@dimen/text_size_tiny"
			android:text="@string/close_sticker_preview" />
	</LinearLayout>

</RelativeLayout>
